        Text(238, 701, "The Green Paradise", Font("Baloo 2", 80));
        // mme:txt {"x":238,"y":701,"w":1272,"h":200,"z":1,"color":"#ffe080","weight":"700","align":"center","id":"_7qe6jv"}
        Text(208, 814, "Suddenly, a cool breeze blew across the open plains. Dark rain clouds rolled across the sky, blocking the sun. Big, heavy drops of water began to splash on the dry dirt.  Ahead of them lay a beautiful, green paradise full of tall trees. Pendo trumpeted loudly with joy and ran into the fresh grass. The long, difficult journey across Africa was finally over. The herd shook their wet skin and began to eat. They were safe, happy, and home at last.", Font("Baloo 2", 32));
        // mme:txt {"x":208,"y":814,"w":1284,"h":300,"z":2,"color":"#f0dd7f","weight":"400","align":"center","shadow":true,"id":"_fk36n0"}
