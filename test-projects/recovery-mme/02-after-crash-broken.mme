        Text(841, 30, "", Font("Rajdhani", 36));
        // mme:txt {"x":841,"y":30,"w":4,"h":1130,"z":3,"color":"#e8a020","weight":"700","align":"center","bgOn":true,"bgColor":"rgba(0,0,0,0.25)","id":"_27se7h"}
        Text(872, 50, "The Long Journey Begins...", Font("Baloo 2", 34));
        // mme:txt {"x":872,"y":50,"w":782,"h":80,"z":4,"color":"#ffe080","weight":"700","align":"left","id":"_7pcbk8"}
        Text(885, 124, "Deep in the African savanna, the golden grass whispered in the wind. \nTembo, a wise old grandmother elephant, lifted her long trunk high. \nShe sniffed the dry, dusty air. \"The rains are late.\" \nTembo rumbled softly to her herd. \n\"It is time for us to walk.\" \nBeside her, a small calf named Pendo shifted his large ears. He had never been on a long march before. The herd gathered closely, their heavy footsteps shaking the earth. \nThey stepped forward, starting a journey of many miles.", Font("Baloo 2", 26));
        // mme:txt {"x":885,"y":124,"w":782,"h":363,"z":5,"color":"#fff2d0","weight":"400","align":"left","vAlign":"top","id":"_nlr7m2"}
