    :"Spread 2"
    EVENT
      Group:
        Display(Face(Pen(1)), Size(1684, 1190));
        // mme:page {"mode":"none","duration":5,"ifCount":1,"ifOp":"==","ifVal":""}
        Text(890, 148, "The sun baked the earth until the ground cracked open. \nPendo’s small legs grew very tired in the heat.\n\"Are we there yet, Grandmother?\" he squeaked. \nTembo touched his back gently with her trunk to comfort him.\n\"Not yet, little one,\" she answered with a low hum.\nThey walked past tall zebras and leaping gazelles.\nThe dust rose up in thick, grey clouds around them.\nTo stay cool, the elephants sprayed dirt over their backs.\nThey kept moving forward, following the ancient paths.", Font("Baloo 2", 26));
        // mme:txt {"x":890,"y":148,"w":782,"h":600,"z":0,"color":"#fff2d0","weight":"400","align":"center","vAlign":"top","id":"_sdz2gq"}
