{
  "name": "fluxaura-studio",
  "private": true,
  "version": "0.1.0",
  "description": "FluxAura Studio — Imagine, Create, Author and Captivate. Your media, Your world, Your way.",
  "author": "FluxAura Studio",
  "license": "UNLICENSED",
  "keywords": [
    "fluxaura",
    "multimedia-authoring",
    "interactive-kiosk",
    "digital-signage",
    "presentation-editor",
    "media-studio"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/start-desktop-dev.cjs",
    "start": "node scripts/start-desktop-dev.cjs",
    "start:web": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node node_modules/vite/bin/vite.js build --debug",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "smoke:publish-toggles": "node scripts/publish-runtime-toggle-smoke.mjs",
    "typecheck:utils": "node node_modules/typescript/bin/tsc --project tsconfig.utils.json",
    "validate": "node scripts/stable-validation.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "desktop:dev": "node scripts/start-desktop-dev.cjs",
    "desktop:prepare": "node scripts/prepare-desktop-build.mjs",
    "desktop:build": "node scripts/build-desktop.mjs --win nsis",
    "desktop:build:mac": "npm run build && npx --yes electron-builder --mac dmg",
    "desktop:pack": "node scripts/build-desktop.mjs --dir",
    "core:validate": "node --trace-uncaught scripts/core-validation.mjs release",
    "commands:audit": "node scripts/command-audit.mjs --app-file src/App.jsx --results-file docs/command-test-results.md --report-dir release",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@xenova/transformers": "^2.0.1",
    "archiver": "^7.0.1",
    "archiver-zip-encrypted": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fengari-web": "^0.1.4",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "nodejs-whisper": "^0.2.9",
    "pdfjs-dist": "^4.4.168",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.5.0",
    "webaudio-tinysynth": "^1.1.3"
  },
  "devDependencies": {
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.58.2",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sharp": "^0.34.5",
    "vite": "^8.0.1"
  },
  "build": {
    "appId": "com.fluxaurastudio.app",
    "productName": "FluxAura Studio",
    "npmRebuild": false,
    "icon": "resources/icon.png",
    "afterPack": "./scripts/afterPack.cjs",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
