erer.config.js',\n          entryPoints: [{\n            name: 'main_window',\n            html: './src/renderer/index.html',\n            js: './src/renderer/index.js',\n            preload: {\n              js: './src/preload.js'\n            }\n          }]\n        }\n      }\n    }\n  ]\n};\n```\n","readmeFilename":"README.md"}